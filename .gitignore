## .gitignore pour une solution .NET (Visual Studio / Rider / VS Code)

# --- Résultats de compilation ---
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
artifacts/
out/
publish/
*.binlog

# --- Fichiers propres à l'utilisateur ---
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# --- Visual Studio ---
.vs/
*.VC.db
*.VC.VC.opendb
*.ncb
*.opendb
*.opensdf
*.sdf
*.cachefile
*.vspscc
*.vssscc
*.pidb
*.svclog
*.scc
ipch/
*.aps
*.tlog
*.ilk
*.meta
*.pdb
*.obj
*.iobj
*.ipdb
*.pgc
*.pgd
*.rsp
*.tmp
*.tmp_proj
*_wpftmp.csproj
*.log
*.tlb
*.tli
*.tlh
*.vspx
*.sap
*.e2e
*_i.c
*_p.c
*_h.h
*.idb
*.psess
*.vsp

# --- JetBrains Rider ---
.idea/
*.sln.iml

# --- Visual Studio Code ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace
.history/

# --- Tests et couverture de code ---
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
coverage*.info
_TeamCity*
*.dotCover
.axoCover/*
!.axoCover/settings.json

# --- NuGet ---
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json
.nuget/

# --- Publication / déploiement ---
*.[Pp]ublish.xml
*.azurePubxml
*.pubxml
*.publishproj
PublishScripts/

# --- Outils divers ---
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
.cr/
*.ncrunch*
_NCrunch_*
nCrunchTemp_*
*.mdf
*.ldf
*.ndf

# --- Secrets et configuration locale ---
.env
.env.*
appsettings.*.local.json
secrets.json
.claude/settings.local.json

# --- Fichiers système ---
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~
*.swp
